<?xml version="1.0" encoding="UTF-16"?>
<!-- officemcp-server Scheduled Task (2026-11-11): auto-start for the Office
     automation service (:8888) — the last of the four Windows-side MCP services
     to get a Logon Task, closing the reboot gap found in the auto-start audit.
     Import (elevated):
       schtasks /create /tn officemcp-server /xml windows\officemcp-task.xml /f
     Run now:  schtasks /run /tn officemcp-server -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>OfficeMCP service (spec 030/031 lane) — SSE on 127.0.0.1:8888, folder C:\OfficeMCP</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\RLWC145\.local\bin\officemcp.exe</Command>
      <Arguments>sse --port 8888 --host 127.0.0.1 --folder C:\OfficeMCP</Arguments>
    </Exec>
  </Actions>
</Task>