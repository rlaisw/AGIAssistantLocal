<?xml version="1.0" encoding="UTF-8"?>
<!-- Spec 037 (T017): auto-start task for the Playwright MCP server (:3002).
     Mirrors the proven windows-mcp-server pattern: logon auto-start, hidden
     window, restart on failure. Import (elevated):
       schtasks /create /tn playwright-mcp-server /xml windows\playwright-mcp-task.xml /f
     Run now:  schtasks /run /tn playwright-mcp-server -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Playwright MCP server (spec 037 dynamic browser lane) — SSE on 127.0.0.1:3002</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- conhost headless wrapper: the node console is INVISIBLE — nobody can
           accidentally close the service window (user request 2026-11-11);
           Chrome windows during actual browsing still show (consent-visible) -->
      <Command>C:\Windows\System32\conhost.exe</Command>
      <Arguments>--headless cmd /c C:\Users\RLWC145\AppData\Roaming\npm\playwright-mcp.cmd --port 3002 --host 127.0.0.1</Arguments>
    </Exec>
  </Actions>
</Task>